# Copy to gateway.env ON THE SERVER. Never put the real key in Git or chat.
OPENROUTER_API_KEY=replace-on-server
DEMO_DOMAIN=demollm.teamrunner.ai
DEMO_MODEL=qwen/qwen3.7-flash
DEMO_STRUCTURED_OUTPUT=json_object
DEMO_ENABLED=true
DEMO_IP_MINUTE=30
DEMO_IP_DAY=100
DEMO_GLOBAL_DAY=1000
DEMO_GLOBAL_MONTH=10000
DEMO_MAX_OUTPUT=512
DEMO_MAX_PROMPT_BYTES=16000
DEMO_CONCURRENCY=4
VERSION_DOMAIN=version.teamrunner.ai
# The oldest TeamRunner the demo answers; 0 answers every version.
MIN_VERSION_FOR_DEMO=0
